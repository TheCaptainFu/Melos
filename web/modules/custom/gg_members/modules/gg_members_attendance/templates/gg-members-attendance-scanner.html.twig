{#
/**
 * @file
 * The scanner on the door device: the camera full screen, reading cards
 * one after another (js/scanner.js), each answered by a coloured screen for
 * a couple of seconds.
 *
 * Available variables:
 * - club, logo (URL or NULL), initial, date, today (how many came today
 *   so far), record_url, token_url (the CSRF token), jsqr_url,
 *   scanner_js_url, back_url and back_label (the coach back to the
 *   Παρουσιολόγιο tab, the door account to its home page).
 */
#}
<!DOCTYPE html>
<html lang="el">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0f172a">
  <title>{{ 'Σκανάρισμα'|t }} — {{ club }}</title>
  {% include '@gg_members_attendance/gg-members-attendance-door.css.twig' %}
  <style>
    .camera { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; }
    .frame { position: fixed; top: 50%; left: 50%; width: min(70vw, 62vh); aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 28px; box-shadow: 0 0 0 100vmax rgba(11,17,32,.55); }
    .frame::before { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 4px; background: linear-gradient(145deg, #60a5fa, #22c55e); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
    .frame::after { content: ""; position: absolute; left: 8%; right: 8%; top: 10%; height: 3px; border-radius: 3px; background: linear-gradient(90deg, rgba(96,165,250,0), #60a5fa, rgba(96,165,250,0)); box-shadow: 0 0 16px #60a5fa; animation: sweep 2.4s ease-in-out infinite; }
    @keyframes sweep { 0%, 100% { top: 10%; } 50% { top: 88%; } }
    @media (prefers-reduced-motion: reduce) { .frame::after { animation: none; top: 50%; } }
    .bar { position: fixed; top: 0; left: 0; right: 0; display: flex; align-items: center; gap: 12px; padding: max(14px, env(safe-area-inset-top)) 16px 28px; background: linear-gradient(rgba(11,17,32,.9), rgba(11,17,32,0)); }
    .bar__club { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 800; text-align: center; }
    .bar__count { padding: 6px 12px; border-radius: 999px; background: rgba(34,197,94,.18); color: #bbf7d0; font-size: .9rem; font-weight: 700; white-space: nowrap; }
    .hint { position: fixed; left: 0; right: 0; bottom: 0; margin: 0; padding: 32px 18px max(22px, env(safe-area-inset-bottom)); background: linear-gradient(rgba(11,17,32,0), rgba(11,17,32,.9)); text-align: center; font-size: 1.15rem; font-weight: 700; }
    .start, .error { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; padding: 24px; text-align: center; }
    .start__inner, .error__inner { width: 100%; max-width: 400px; display: flex; flex-direction: column; align-items: center; gap: 22px; }
    .start__icon { position: relative; display: grid; place-items: center; width: 132px; height: 132px; border-radius: 36px; background: rgba(96,165,250,.12); color: #93c5fd; }
    .start__icon::before { content: ""; position: absolute; inset: -10px; border-radius: 44px; border: 2px solid rgba(96,165,250,.25); animation: pulse 2.2s ease-out infinite; }
    @keyframes pulse { 0% { transform: scale(.92); opacity: 1; } 100% { transform: scale(1.12); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .start__icon::before { animation: none; } }
    .start__icon svg { width: 64px; height: 64px; }
    .start__title { margin: 0; font-size: 1.5rem; font-weight: 800; }
    .start__text { margin: -12px 0 0; line-height: 1.5; }
    .error__icon { display: grid; place-items: center; width: 84px; height: 84px; border-radius: 26px; background: rgba(239,68,68,.15); color: #fca5a5; }
    .error__icon svg { width: 42px; height: 42px; }
    .error p { max-width: 380px; margin: 0; line-height: 1.55; }
    .back { position: absolute; top: max(14px, env(safe-area-inset-top)); left: 14px; }
    .bar .g-ghost { padding: 8px 14px; }
    [hidden] { display: none !important; }
  </style>
</head>
<body class="g-bg">
  <video class="camera" playsinline muted></video>
  <div class="frame" aria-hidden="true"></div>
  <div class="bar">
    {% if back_url %}<a class="g-ghost" href="{{ back_url }}">{{ back_label }}</a>{% endif %}
    <span class="bar__club">{{ club }}</span>
    <span class="bar__count" data-count>{{ 'Σήμερα: @count'|t({'@count': today}) }}</span>
  </div>
  <p class="hint">{{ 'Δείξε την κάρτα σου στην κάμερα'|t }}</p>

  {# Browsers start the camera (and sound) only after a tap. #}
  <div class="start g-bg" data-start>
    {% if back_url %}<a class="back g-ghost" href="{{ back_url }}">{{ back_label }}</a>{% endif %}
    <div class="start__inner">
      <div class="g-brand">
        {% if logo %}<img class="g-logo" src="{{ logo }}" alt="">{% endif %}
        <p class="g-club">{{ club }}</p>
        <span class="g-pill">{{ 'Σήμερα: @count'|t({'@count': today}) }}</span>
      </div>
      <span class="start__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><rect x="7" y="7" width="4" height="4" rx=".5"/><rect x="13" y="13" width="4" height="4" rx=".5"/><path d="M13 7h4v2M7 15v2h2"/></svg>
      </span>
      <p class="start__title">{{ 'Έτοιμο για σκανάρισμα'|t }}</p>
      <p class="start__text g-muted">{{ 'Την πρώτη φορά το κινητό θα ζητήσει άδεια για την κάμερα — πατήστε «Να επιτρέπεται».'|t }}</p>
      <button type="button" class="g-primary">{{ 'Έναρξη σκαναρίσματος'|t }}</button>
    </div>
  </div>
  <div class="error g-bg" data-error hidden>
    {% if back_url %}<a class="back g-ghost" href="{{ back_url }}">{{ back_label }}</a>{% endif %}
    <div class="error__inner">
      <span class="error__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><path d="M1 1l22 22"/></svg>
      </span>
      <p data-error-text></p>
      <button type="button" class="g-primary" onclick="location.reload()">{{ 'Ξανά'|t }}</button>
    </div>
  </div>
  <div data-result hidden></div>

  <script>
    window.ggScanner = {
      recordUrl: {{ record_url|json_encode|raw }},
      tokenUrl: {{ token_url|json_encode|raw }},
      jsqrUrl: {{ jsqr_url|json_encode|raw }},
      text: {
        count: {{ 'Σήμερα: @count'|t|json_encode|raw }},
        noCamera: {{ 'Δεν άνοιξε η κάμερα. Επιτρέψτε την πρόσβαση στην κάμερα για αυτή τη σελίδα (το εικονίδιο δίπλα στη διεύθυνση) και πατήστε «Ξανά».'|t|json_encode|raw }},
        insecure: {{ 'Η κάμερα ανοίγει μόνο σε ασφαλή σύνδεση (https://).'|t|json_encode|raw }},
        offline: {{ 'Δεν υπάρχει σύνδεση. Δοκίμασε ξανά.'|t|json_encode|raw }},
        welcome: {{ 'Καλώς ήρθες!'|t|json_encode|raw }},
        seeCoach: {{ 'Πέρασε από τον προπονητή.'|t|json_encode|raw }},
        again: {{ 'Έχεις ήδη περαστεί σήμερα'|t|json_encode|raw }},
        inactive: {{ 'Ανενεργό μέλος'|t|json_encode|raw }},
        unknown: {{ 'Άγνωστη ή παλιά κάρτα'|t|json_encode|raw }}
      }
    };
  </script>
  <script src="{{ scanner_js_url }}"></script>
</body>
</html>
