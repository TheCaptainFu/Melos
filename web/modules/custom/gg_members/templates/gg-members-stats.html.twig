{#
/**
 * @file
 * Statistics page for the GG Members module.
 *
 * Available variables:
 * - history: see MemberStats::history() — months, partial, empty, from, to;
 *   or, with one month picked, MemberStats::monthHistory() — single, label.
 *   With less than a year of data (partial), a note says where the numbers
 *   start and the year-based wording changes to "from <month>".
 * - chart: the month columns' state (selected month, …), see
 *   MemberStatsController::period().
 * - basics: see MemberStats::basics() — total, average, average_months,
 *   closed_months.
 * - monthly: see MemberStats::monthly() — months (label, name, year, amount,
 *   percent, closed, current, best), best_amount.
 * - by_class: see MemberStats::byClass() — total, members, and classes (name,
 *   color, revenue, revenue_percent, members, members_percent, average).
 * - members: see MemberStats::members() — active, active_year_ago, joined,
 *   left, tenure, and classes (name, color, active, active_percent, joined,
 *   left, age, tenure).
 */
#}
{# lang="el" so text-transform: uppercase drops the accents. #}
<div class="gg-members-admin gg-members-statspage" lang="el">
  {% if history.single %}
    {# One month picked: nothing year-based. #}
  {% elseif history.empty %}
    <div class="gg-members-notice">
      <p>{{ 'Δεν έχουν καταχωρηθεί ακόμα πληρωμές. Τα στατιστικά θα εμφανιστούν μόλις καταχωρηθούν οι πρώτες.'|t }}</p>
    </div>
  {% elseif history.partial %}
    <div class="gg-members-notice">
      <p>{{ 'Τα στοιχεία ξεκινούν από τον @from, όταν άρχισε να χρησιμοποιείται το πρόγραμμα. Όσο περνάει ο καιρός, τα στατιστικά θα γίνονται πιο πλήρη.'|t({'@from': history.from}) }}</p>
    </div>
  {% endif %}

  {% if history.single %}
    <div class="gg-members-stats gg-members-stats--big">
      <div class="gg-members-stat">
        <span class="gg-members-stat__value">{{ basics.total|number_format(2, ',', '.') }}€</span>
        <span class="gg-members-stat__label">{{ 'Έσοδα @month'|t({'@month': history.label}) }}</span>
        <span class="gg-members-stat__sub">{{ 'Όσα πληρώθηκαν μέσα στον μήνα.'|t }}</span>
      </div>
      <div class="gg-members-stat">
        <span class="gg-members-stat__value">{{ basics.count }}</span>
        <span class="gg-members-stat__label">{{ basics.count == 1 ? 'Πληρωμή'|t : 'Πληρωμές'|t }}</span>
        <span class="gg-members-stat__sub">{{ basics.members == 1 ? '1 μέλος πλήρωσε'|t : '@count μέλη πλήρωσαν'|t({'@count': basics.members}) }}</span>
      </div>
    </div>
  {% else %}
  <div class="gg-members-stats gg-members-stats--big">
    <div class="gg-members-stat">
      <span class="gg-members-stat__value">{{ basics.average|number_format(2, ',', '.') }}€</span>
      <span class="gg-members-stat__label">{{ 'Μέσος όρος εσόδων / μήνα'|t }}</span>
      <span class="gg-members-stat__sub">
        {% if not basics.average_months %}
          {{ 'Ο πρώτος μήνας δεν έχει ολοκληρωθεί ακόμα, οπότε είναι τα έσοδα μέχρι σήμερα.'|t }}
        {% elseif basics.average_months == 1 %}
          {{ 'Από τον 1 ολοκληρωμένο μήνα λειτουργίας.'|t }}
        {% elseif basics.closed_months %}
          {{ 'Από τους @count ολοκληρωμένους μήνες λειτουργίας (χωρίς τους κλειστούς μήνες).'|t({'@count': basics.average_months}) }}
        {% else %}
          {{ 'Από τους @count ολοκληρωμένους μήνες λειτουργίας.'|t({'@count': basics.average_months}) }}
        {% endif %}
      </span>
    </div>
    <div class="gg-members-stat">
      <span class="gg-members-stat__value">{{ basics.total|number_format(2, ',', '.') }}€</span>
      <span class="gg-members-stat__label">{{ history.partial ? 'Έσοδα μέχρι σήμερα'|t : 'Έσοδα τελευταίου χρόνου'|t }}</span>
      <span class="gg-members-stat__sub">{{ 'Όσα πληρώθηκαν από τον @from έως τον @to.'|t({'@from': history.from, '@to': history.to}) }}</span>
    </div>
  </div>

  {% endif %}

  {% include '@gg_members/gg-members-stats-monthly.html.twig' with {
    monthly: monthly,
    chart: chart,
    title: 'Έσοδα ανά μήνα'|t,
    subtitle: 'Πόσα πληρώθηκαν κάθε μήνα.'|t,
    variant: 'income',
    best_label: 'καλύτερος'|t,
  } only %}

  {% if by_class.classes %}
    <section class="gg-members-by-class">
      <header class="gg-members-section-header">
        <h2>{{ 'Ανά τμήμα'|t }}</h2>
        <p>{{ history.single ? 'Πόσα έσοδα έφερε κάθε τμήμα τον @month, και πόσα από τα ενεργά μέλη έχει.'|t({'@month': history.from}) : 'Πόσα από τα παραπάνω έσοδα έφερε κάθε τμήμα, και πόσα από τα ενεργά μέλη έχει.'|t }}</p>
      </header>
      <div class="gg-members-class-grid">
        {% for class in by_class.classes %}
          <div class="gg-members-card gg-members-class-card" style="--class-color: {{ class.color }}">
            <div class="gg-members-class-card__head">
              <h3 class="gg-members-class-card__name">{{ class.name }}</h3>
              <span class="gg-members-class-card__percent">{{ class.revenue_percent }}%</span>
            </div>
            <div class="gg-members-class-card__amount">{{ class.revenue|number_format(2, ',', '.') }}€</div>
            <div class="gg-members-class-card__caption">{{ 'του συνόλου των εσόδων'|t }}</div>
            <span class="gg-members-progress gg-members-class-card__bar" aria-hidden="true"><span class="gg-members-progress__bar" style="width: {{ class.revenue_percent }}%"></span></span>
            <dl class="gg-members-class-card__facts">
              <div>
                <dt>{{ 'Μέλη'|t }}</dt>
                <dd>{{ class.members }} <span>({{ class.members_percent }}%)</span></dd>
              </div>
              <div>
                {% if history.single %}
                  <dt>{{ 'Πληρωμές'|t }}</dt>
                  <dd>{{ class.payments }}</dd>
                {% else %}
                  <dt>{{ 'Μέσος όρος / μήνα'|t }}</dt>
                  <dd>{{ class.average|number_format(2, ',', '.') }}€</dd>
                {% endif %}
              </div>
            </dl>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="gg-members-people">
    <header class="gg-members-section-header">
      <h2>{{ 'Μέλη'|t }}</h2>
      <p>
        {% if history.single %}
          {{ 'Πόσα μέλη έχετε σήμερα, και πόσα ήρθαν και έφυγαν τον @month.'|t({'@month': history.from}) }}
        {% elseif history.partial %}
          {{ 'Πόσα μέλη έχετε, πόσα ήρθαν και πόσα έφυγαν από τον @from.'|t({'@from': history.from}) }}
        {% else %}
          {{ 'Πόσα μέλη έχετε, πόσα ήρθαν και πόσα έφυγαν τον τελευταίο χρόνο.'|t }}
        {% endif %}
      </p>
    </header>
    <div class="gg-members-stats">
      <div class="gg-members-stat">
        <span class="gg-members-stat__value">{{ members.active }}</span>
        <span class="gg-members-stat__label">{{ 'Ενεργά μέλη'|t }}</span>
        <span class="gg-members-stat__sub">
          {% if members.active_year_ago is not null %}
            {{ 'πριν από έναν χρόνο: @count'|t({'@count': members.active_year_ago}) }}
          {% else %}
            {{ 'σήμερα'|t }}
          {% endif %}
        </span>
      </div>
      <div class="gg-members-stat">
        <span class="gg-members-stat__value{{ members.joined ? ' gg-members-stat__value--up' }}">{{ members.joined ? '+' ~ members.joined : 0 }}</span>
        <span class="gg-members-stat__label">{{ 'Ήρθαν'|t }}</span>
        <span class="gg-members-stat__sub">
          {% if history.single %}{{ 'νέες εγγραφές τον @month'|t({'@month': history.from}) }}
          {% elseif history.partial %}{{ 'νέες εγγραφές από τον @from'|t({'@from': members.joined_from}) }}
          {% else %}{{ 'νέες εγγραφές τον τελευταίο χρόνο'|t }}{% endif %}
        </span>
      </div>
      <div class="gg-members-stat">
        <span class="gg-members-stat__value{{ members.left ? ' gg-members-stat__value--down' }}">{{ members.left ? '−' ~ members.left : 0 }}</span>
        <span class="gg-members-stat__label">{{ 'Έφυγαν'|t }}</span>
        <span class="gg-members-stat__sub">
          {% if history.single %}{{ 'αποχωρήσεις τον @month'|t({'@month': history.from}) }}
          {% elseif history.partial %}{{ 'αποχωρήσεις από τον @from'|t({'@from': history.from}) }}
          {% else %}{{ 'αποχωρήσεις τον τελευταίο χρόνο'|t }}{% endif %}
        </span>
      </div>
      {% if members.tenure is not null %}
        <div class="gg-members-stat">
          <span class="gg-members-stat__value">{{ members.tenure }} <span class="gg-members-stat__of">{{ 'μήνες'|t }}</span></span>
          <span class="gg-members-stat__label">{{ 'Μέση παραμονή'|t }}</span>
          <span class="gg-members-stat__sub">{{ 'πόσο μένει κατά μέσο όρο ένα μέλος'|t }}</span>
        </div>
      {% endif %}
    </div>

    {% if members.classes %}
      {% set largest = max(members.classes|column('active')|merge([1])) %}
      <h3 class="gg-members-subsection-title">{{ 'Μέλη ανά τάξη'|t }}</h3>
      <div class="gg-members-card gg-members-people-table">
        <table>
          <thead>
            <tr>
              <th>{{ 'Τάξη'|t }}</th>
              <th>{{ 'Ενεργά μέλη'|t }}</th>
              <th>{{ 'Ήρθαν / Έφυγαν'|t }}</th>
              <th>{{ 'Μεταβολή'|t }}</th>
              <th>{{ 'Μέση ηλικία'|t }}</th>
              {% if members.tenure is not null %}
                <th>{{ 'Μέση παραμονή'|t }}</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for class in members.classes %}
              {% set change = class.joined - class.left %}
              <tr style="--class-color: {{ class.color }}">
                <td class="gg-members-people-table__name">{{ class.name }}</td>
                <td data-label="{{ 'Ενεργά μέλη'|t }}">
                  <div class="gg-members-people-table__active">
                    <span class="gg-members-people-table__track" aria-hidden="true"><span style="width: {{ (class.active / largest * 100)|round(1) }}%"></span></span>
                    <strong>{{ class.active }}</strong>
                    <span class="gg-members-people-table__muted">{{ class.active_percent }}%</span>
                  </div>
                </td>
                <td data-label="{{ 'Ήρθαν / Έφυγαν'|t }}">
                  <span class="gg-members-people-table__pills">
                    <span class="gg-members-pill gg-members-pill--{{ class.joined ? 'up' : 'zero' }}" title="{{ 'Ήρθαν'|t }}">{{ class.joined ? '+' ~ class.joined : 0 }}</span>
                    <span class="gg-members-pill gg-members-pill--{{ class.left ? 'down' : 'zero' }}" title="{{ 'Έφυγαν'|t }}">{{ class.left ? '−' ~ class.left : 0 }}</span>
                  </span>
                </td>
                <td data-label="{{ 'Μεταβολή'|t }}">
                  {% if change > 0 %}
                    <span class="gg-members-people-table__change is-up">▲ +{{ change }}</span>
                  {% elseif change < 0 %}
                    <span class="gg-members-people-table__change is-down">▼ −{{ -change }}</span>
                  {% else %}
                    <span class="gg-members-people-table__change">— 0</span>
                  {% endif %}
                </td>
                <td data-label="{{ 'Μέση ηλικία'|t }}">{{ class.age is not null ? '@age ετών'|t({'@age': class.age}) : '—' }}</td>
                {% if members.tenure is not null %}
                  <td data-label="{{ 'Μέση παραμονή'|t }}">{{ class.tenure is not null ? '@count μήνες'|t({'@count': class.tenure}) : '—' }}</td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>
</div>
